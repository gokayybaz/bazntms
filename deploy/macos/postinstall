#!/bin/bash
# macOS pkg postinstall — LaunchDaemon yuklenir; konfigurasyon yoksa
# ornek dosyadan agent.yml olarak kopyalanir (dogrudan doldurulabilsin diye).
if [ ! -f /etc/bazntms/agent.yml ]; then
    mkdir -p /etc/bazntms
    cp /usr/local/share/bazntms/bazntms-agent.yml.example /etc/bazntms/agent.yml 2>/dev/null || true
    echo "bazNTMS agent kuruldu. /etc/bazntms/agent.yml dosyasini doldurup 'sudo launchctl load /Library/LaunchDaemons/local.bazntms.agent.plist' ile baslatin."
else
    launchctl load /Library/LaunchDaemons/local.bazntms.agent.plist || true
fi
exit 0
