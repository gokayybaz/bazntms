[Unit]
Description=bazNTMS hub — network traffic monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bazntms-hub -config /etc/bazntms/hub.yml
Restart=always
RestartSec=5
# hub'in kendi paket yakalamasi icin (capture.enabled=true ise)
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
# NetFlow/syslog UDP dinleri 80'in altina alinabilir
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
