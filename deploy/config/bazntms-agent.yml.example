# bazNTMS agent ornek yapilandirmasi.
# Gercek konfigurasyonu /etc/bazntms/agent.yml olarak kopyalayip doldurun.
# (Not: `bazntmsctl setup` HUB icin kurulum sihirbazidir, agent icin degil
# — Windows MSI ve macOS .pkg kurulumlari kendi sihirbazlarinda bu
# alanlari (hub url/token/site) zaten soruyor.)

hub:
  # Hub adresi ve ilk-kayit token'i. BOS BIRAKMAYIN — elle kurulumda doldurun
  # (or. url: https://hub.example.com). Windows MSI / macOS .pkg kurulumlari bu
  # alanlari kendi sihirbazlarinda (veya msiexec HUBURL=/ENROLLTOKEN= ozellikleri
  # ile) doldurur; bu ornek dosyadaki bos degerler kasitlidir ki eksik yapilandirma
  # sessizce yanlis bir adrese baglanmak yerine acik hata versin.
  # Birden fazla hub: virgulle ayirin → failover sirasi (Faz 5.4).
  url: ""
  token: ""   # yalnizca ilk kayit icin gerekli
  # mTLS (hub -tls ile calisiyorsa): hub CA sertifikasini onceden pinleyin.
  # Bos birakilirsa ilk baglantida guvenilir kabul edilip otomatik pinlenir (TOFU).
  # ca_file: /etc/bazntms/hub-ca.crt

agent:
  name: sunucu-01      # bos → hostname
  site: genel-merkez   # site scope (RBAC) ve filo organizasyonu

collect:
  interval_seconds: 30
  # derin toplama: surec bazli trafik + DNS + L7 (SNI/Host) gorunurlugu.
  # Bu paneller yalnizca bu acikken dolar; hub tarafinda da `-agent-pcap`
  # politikasi acik olmali (tek basina zorla baslatmaz, izin verir).
  pcap: true
  # atif arka ucu:
  #   auto (varsayilan) — Linux: eBPF (kernel >= 5.8 + BTF) -> pcap
  #                       Windows: ETW (SYSTEM/yonetici) -> pcap
  #                       macOS: pcap
  #   ebpf | etw | pcap  — zorla (kurulamazsa hata, dusme yok)
  #   off               — atfi tamamen kapat
  # eBPF/ETW cekirdek duzeyinde toplar: CAP_NET_RAW / Npcap gerekmez.
  # L7 (SNI/Host) payload gerektirir → yalnizca pcap; ETW modunda yoktur
  # (gerekiyorsa method: pcap + Npcap).
  method: auto
  # yalnizca method pcap iken kullanilir. auto: ilk yonlendirilebilir arayuz;
  # Windows'ta friendly ad ("Ethernet") otomatik \Device\NPF_{GUID}'a cevrilir.
  pcap_interface: auto
  # ham PCAP kaydi (hub politikasi da acik olmali)
  pcap_record: false
  pcap_dir: /var/lib/bazntms/captures

# otomatik guncelleme — VARSAYILAN ACIK. Hub, GitHub release'lerinden
# yeni agent binary'lerini kendi guncelleme kanalina senkron eder; agent
# her interval_hours'ta sorgular, yukselme varsa indirip SHA-256 dogrular
# ve kendini degistirir (supervisor yeniden baslatir).
# update:
#   disabled: false          # true → bu agent'ta otomatik guncelleme kapali
#   channel: stable          # stable | beta
#   interval_hours: 6
#   public_key: "<ed25519-hex>"   # yalnizca imzali kanal (bazntmsctl update sign) kullaniyorsaniz

log:
  level: info
  format: json
