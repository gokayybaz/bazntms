# bazntms-loadgen imajı: sentetik agent filosu (bkz. loadtest/)
# Build context repo köküdür:
#   docker build -f deploy/Dockerfile.loadgen -t bazntms-loadgen:local .
# Yalnızca geliştirme/ölçek testi — release'de yayınlanmaz.

FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS build
WORKDIR /src
RUN apk add --no-cache gcc musl-dev libpcap-dev
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -trimpath \
    -o /out/bazntms-loadgen ./cmd/bazntms-loadgen

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/bazntms-loadgen /usr/local/bin/bazntms-loadgen
ENTRYPOINT ["bazntms-loadgen"]
