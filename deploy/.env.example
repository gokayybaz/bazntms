# deploy/.env.example — kopyalayip deploy/.env yapin (git'e girmez, bkz. .gitignore),
# gercek degerleri doldurun. docker compose ayni dizindeki .env dosyasini otomatik okur.

# Jev (TypeSafe AI) triyaj on-filtresi (Faz 27). Bos birakilirsa Jev fiilen
# devre disi kalir: -ai-jev-api-key=${JEV_API_KEY} bos string olur, Jev
# istekleri 401 doner, Triager fail-open ile eski severity+rate-limit
# davranisina duser (bkz. internal/ai/triage.go jevWorthTriage).
JEV_API_KEY=
