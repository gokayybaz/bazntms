# binary (yalnizca repo koku — deploy/helm/bazntms dizinini yutmasin!)
/bazntms
/bazntms.exe
/bazntms-agent
/bazntmsctl
/bazntms-*
/banner
/loadgen

# veri tabani / kayitlar
*.db
*.db-wal
*.db-shm
captures/
*.pcap

# geoip veri tabanlari (lisansli indirilir, commit edilmez)
geoip/*.mmdb

# frontend / docs-site
node_modules/
docs-site/build/
docs-site/.docusaurus/
web/dist/*
!web/dist/.gitkeep

# diger
*.log
.DS_Store

# kimlik kasasi master key (gizli, makineye ozel)
/vault.key

# mTLS PKI (hub CA + sunucu sertifikasi) + agent istemci sertifikalari
/pki/
*.state.json
*.state.json.*
bazntms-agent.state.*

# yerel `wix build` calistirmalari icin extension/nuget onbellegi
.wix/

# impeccable tasarim skill'inin oturum-bazli calisma zamani onbellegi —
# makineye/oturuma ozel mutlak yol + session id iceriyor, .impeccable/
# config.json (paylasilan ignore kurallari) ve critique/ (kalici raporlar)
# ise kasitli olarak izleniyor
.impeccable/hook.cache.json
frontend/.impeccable/
