# Faz 21 yük profili — PATLAMA (regresyon geçidi)
#
# Enterprise hedefi 200k flow/sn 5 dk kayıpsızdır. Bu, tek-node Docker Desktop
# yığınında paylaşımlı NATS FileStorage + Postgres'i doyuruyor (flow verisi
# kaybolmuyor — NATS buffer'lıyor, patlama sonrası tam boşalıyor — ama agent
# telemetrisi geçici olarak etkileniyor). Bkz. docs/CAPACITY.md §2b.
#
# Bu profil yerel REGRESYON GEÇİDİ olarak 120k'ye ayarlı — laptop yığınının
# kayıpsız + p95 altında karşıladığı seviye. Tam 200k üretim donanımı ister
# (ayrı NATS node / memory storage, yüksek DB IOPS, +ingest replika).

AGENTS=5000
INTERVAL=30
FLOW_RATE=20000
FLOW_BURST=120000
FLOW_BURST_AFTER=3m
FLOW_BURST_FOR=5m
FLOW_PROTO=mix
FLOW_EXPORTERS=16
DEVICES=1000
DEVICE_POLL=60
DURATION=12m
WARMUP=1m

# eşikler — patlama sırasında p95 ve kuyruk gevşer, düşürme ~0
MAX_P95_MS=400
MIN_TELEMETRY_RPS=155
MAX_QUEUE_PENDING=400000
MAX_FLOW_DROP_RATE=1
MAX_DEVPOLL_CYCLE_S=55
