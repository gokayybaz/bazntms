# Faz 21 yük profili — PATLAMA
# Taban flow yükü üzerine 200k flow/sn 5 dk patlama (enterprise: "200K flow/sn
# 5 dk kayıpsız — NATS buffer"). Kuyruk birikip patlama sonrası boşalmalı.

AGENTS=5000
INTERVAL=30
FLOW_RATE=20000
FLOW_BURST=200000
FLOW_BURST_AFTER=3m
FLOW_BURST_FOR=5m
FLOW_PROTO=mix
FLOW_EXPORTERS=16
DEVICES=1000
DEVICE_POLL=60
DURATION=12m
WARMUP=1m

# eşikler — patlama sırasında p95 ve kuyruk gevşer, düşürme yine 0
MAX_P95_MS=400
MIN_TELEMETRY_RPS=160
MAX_QUEUE_PENDING=200000
MAX_FLOW_DROP_RATE=0
MAX_DEVPOLL_CYCLE_S=55
