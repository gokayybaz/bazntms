# Faz 21 yük profili — TABAN ÇİZGİSİ
# Hızlı doğrulama: hedefin ~%10'u, birkaç dakika. Geliştirme sırasında
# regresyon yakalamak için — tam kapasite için `target` kullanın.

AGENTS=500
INTERVAL=30
FLOW_RATE=5000
FLOW_PROTO=mix
FLOW_EXPORTERS=8
DEVICES=100
DEVICE_POLL=60
DURATION=3m
WARMUP=30s

# eşikler (perf_summary.py)
MAX_P95_MS=250
MIN_TELEMETRY_RPS=12
MAX_QUEUE_PENDING=5000
MAX_FLOW_DROP_RATE=0
MAX_DEVPOLL_CYCLE_S=48
